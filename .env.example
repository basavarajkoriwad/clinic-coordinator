# ==============================================================================
# The Bengaluru Clinic - Environment Configuration
# Copy this file to .env and adjust variables as required.
# DO NOT commit .env containing real credentials or secrets to version control.
# ==============================================================================

# Application Base URL (used for email links, single-click unsubscribes, verification)
BASE_URL=http://localhost:8000

# Secret Key for cryptographic token derivation and CSRF protection
SECRET_KEY=replace-with-a-random-32-byte-hex-string

# Mail Mode:
# 'dev'  - Emails are logged to SQLite data/clinic.db and viewed live in /dev/mailbox
# 'smtp' - Real outgoing SMTP delivery with STARTTLS
MAIL_MODE=dev

# SMTP Credentials (Required only when MAIL_MODE=smtp)
# For Gmail: Use smtp.gmail.com, port 587, and a 16-character Google App Password
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=clinic.notifications@example.com
SMTP_PASSWORD=your-app-password-here
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15

# Outgoing Sender Identity
MAIL_FROM_NAME=The Bengaluru Clinic
MAIL_FROM_ADDRESS=appointments@bengaluru-clinic.in

# Clinic Legal Identity (Used on Tax Invoices & Legal Disclaimers)
CLINIC_LEGAL_NAME=The Bengaluru Clinic Healthcare Pvt. Ltd.
CLINIC_ADDRESS=Suite 302, 3rd Floor, Indiranagar 100ft Road, Bengaluru, Karnataka 560038
CLINIC_GSTIN=29AAAAA0000A1Z5
CLINIC_PHONE=+91 80 4000 0000

# Invoice & Tax Settings
# Default TAX_RATE_PERCENT is 0.0 (Exempt under Notification No. 12/2017-Central Tax)
TAX_RATE_PERCENT=0.0
TAX_NOTE=Healthcare services by clinical psychologists/medical practitioners are exempt under Notification No. 12/2017-Central Tax (Rate). Tax treatment subject to formal CA review.
SAC_CODE=999312
INVOICE_PREFIX=TBC-INV-
